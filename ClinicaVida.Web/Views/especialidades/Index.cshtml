@model IEnumerable<Especialidade>

@{
    ViewData["Title"] = "Especialidades";
    var contagem =
        (Dictionary<int, int>)ViewBag.MedicosPorEspecialidade;
}

<h1>Especialidades da Clínica Vida+</h1>

<ul>
    @foreach (var especialidade in Model)
    {
        <li>
            <a asp-controller="Medicos"
               asp-action="Index"
               asp-route-especialidadeId="@especialidade.Id">
                @especialidade.Nome
            </a>
            — @contagem[especialidade.Id] médico(s)
        </li>
    }
</ul>

<a asp-controller="Medicos" asp-action="Index">
    Ver todos os médicos
</a>